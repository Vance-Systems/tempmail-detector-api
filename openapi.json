{
  "openapi": "3.0.0",
  "info": {
    "title": "TempMail - Disposable & Burner Email Detection API",
    "description": "Real-time detection of 65,000+ disposable, burner, and temporary email domains to stop bot registrations and trial abuse.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://vance-systems.github.io",
      "description": "Vance Systems Production Gateway"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "Service Operational"
          }
        }
      }
    },
    "/v1/domains/disposable": {
      "get": {
        "summary": "List recognized disposable and temporary email domain patterns",
        "responses": {
          "200": {
            "description": "Disposable domain catalog"
          }
        }
      }
    },
    "/v1/detect": {
      "post": {
        "summary": "Check if an email address belongs to a disposable or throwaway domain",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@mailinator.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Disposable email risk score and classification"
          }
        }
      }
    }
  }
}